<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='gcs_cam'>
    <self_collide>false</self_collide>
    <include merge='true'>
      <uri>x500</uri>
    </include>

    <!-- Nadir camera, inline (not model://mono_cam) so we control the
         resolution: 640x480 @ 30 fps matches the desktop GCS video
         pipeline's working resolution, keeping decode cost low.
         Link pitch 1.5707 rad = camera +x axis points straight down. -->
    <link name="camera_link">
      <pose relative_to="base_link">0 0 0.10 0 1.5707 0</pose>
      <inertial>
        <pose>0.03 0.03 0.03 0 0 0</pose>
        <mass>0.050</mass>
        <inertia>
          <ixx>0.00004</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00004</iyy><iyz>0</iyz><izz>0.00004</izz>
        </inertia>
      </inertial>
      <visual name="visual_housing">
        <geometry><box><size>0.02 0.04 0.04</size></box></geometry>
      </visual>
      <sensor name="imager" type="camera">
        <gz_frame_id>camera_link</gz_frame_id>
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.74</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>RGB_INT8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>3000</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
      </sensor>
    </link>
    <joint name="CameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <!-- NOTE: no <plugin> block here on purpose. PX4's gz server.config
         already loads GstCameraSystem world-wide with defaults
         127.0.0.1:5600 and auto-discovers the first camera in the world;
         a model-level instance would double-stream to the same port. -->
  </model>
</sdf>
