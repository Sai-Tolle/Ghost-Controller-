<?xml version="1.0"?>
<model>
  <name>gcs_cam</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Ghost Handler</name>
    <email>dev@ghost-handler.local</email>
  </author>
  <description>
    x500 quad with a nadir mono camera whose images stream out as RTP/H.264
    on UDP 5600 via PX4's gz gstreamer plugin (GstCameraSystem). Built for
    desktop GCS end-to-end testing (video + telemetry + tiles).
  </description>
</model>
