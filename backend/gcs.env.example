# Copy this file to gcs.env on the Raspberry Pi.
# Prefer the stable /dev/serial/by-id path when available.
MAVLINK_CONNECTION=/dev/ttyUSB0
MAVLINK_BAUD=115200
MAVLINK_REQUIRE_CONNECTION=1

# Optional server settings
GCS_HOST=0.0.0.0
GCS_PORT=8000
GCS_LOG_LEVEL=info

# AI flight assistant (text + voice). Leave OPENAI_API_KEY empty to disable.
# Any OpenAI-compatible endpoint works via AI_API_BASE (Groq, OpenRouter, LM Studio).
OPENAI_API_KEY=
AI_MODEL=gpt-5.6-luna
# gpt-5.x models need reasoning_effort set ("none" enables function tools on
# chat completions). Clear it for models that reject the parameter.
AI_REASONING_EFFORT=none
AI_STT_MODEL=whisper-1
# AI_API_BASE=https://api.openai.com/v1

# Video source (optional). Custom RTSP / MJPEG URLs are probed FIRST within
# their family, before the built-in defaults. They can also be set at runtime
# from the frontend VIDEO dropdown (which writes them back here). Leave empty
# for auto-detection only.
# VIDEO_RTSP_URL=rtsp://user:pass@192.168.1.10:554/stream
# VIDEO_MJPEG_URL=http://192.168.4.1:8080/video

# Startup source selection (auto | udp_rtp | rtsp | mjpeg). Written
# automatically by the backend whenever you pick a source in the UI, so the
# chosen source is used on every boot until you change it (UI or here).
# VIDEO_SOURCE_MODE=auto

# Vehicle detection (AI vision). The YOLO model is downloaded automatically on
# first use; VISION_MODEL_PATH overrides where it is stored. To deploy a
# fine-tuned aerial model (tools/train_vision.py), point VISION_MODEL_PATH at
# the tuned ONNX (e.g. vision/models/yolo11n_aerial.onnx) and optionally set
# VISION_CLASS_NAMES if the model is not 10-class VisDrone or 1-class vehicle.
VISION_MODEL_PATH=vision/models/yolo11n.onnx
# VISION_CLASS_NAMES=car,truck,bus,motorcycle,bicycle,pedestrian
VISION_CONFIDENCE=0.35
VISION_RATE_HZ=5

# False-positive suppression (clouds read as aircraft on aerial video).
# VISION_SKY_FILTER drops low-confidence detections above the estimated
# horizon; VISION_IGNORE_LABELS removes labels outright (comma-separated).
VISION_SKY_FILTER=1
VISION_SKY_MIN_CONF=0.65
VISION_IGNORE_LABELS=aircraft
# Watch mode publishes a track only after this many consecutive sightings.
VISION_MIN_SIGHTINGS=2

# Optional vision-language model for military/civilian estimation. Leave
# VISION_VLM_KEY empty to use geometry-only classification (no image uploads).
# VISION_VLM_MODEL=gpt-5-mini
# VISION_VLM_BASE=https://api.openai.com/v1
# VISION_VLM_KEY=
