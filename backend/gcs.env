# Local GCS configuration — DO NOT COMMIT (already in .gitignore)

# MAVLink transport
MAVLINK_CONNECTION=
MAVLINK_BAUD=115200
MAVLINK_REQUIRE_CONNECTION=0

# Server
GCS_HOST=0.0.0.0
GCS_PORT=8000
GCS_LOG_LEVEL=info

# AI flight assistant
OPENAI_API_KEY=
AI_MODEL=gpt-5.6-luna
AI_STT_MODEL=whisper-1
AI_API_BASE=https://api.openai.com/v1
VIDEO_SOURCE_MODE=auto
